---
import '@/styles/global.css'
import '@/styles/typography.css'

import AudioPlayer from '@/components/AudioPlayer.astro'
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  /** max-width class shared by the header and footer, so both line up with the page content */
  width?: string
  /** show the avatar and name in the header; the home page already has them */
  identity?: boolean
}

const { class: className, width, identity } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col font-sans">
    <header
      class="bg-background/80 sticky top-0 z-50 divide-y backdrop-blur-md xl:divide-none"
    >
      <Header width={width} identity={identity} />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      class={cn(
        'w-full mx-auto flex grow flex-col gap-y-6 px-4 pb-8',
        className,
      )}
    >
      <slot />
    </main>
    <Footer width={width} />
    <AudioPlayer />
  </body>
</html>
