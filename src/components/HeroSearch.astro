---
// HeroSearch.astro - osu! beatmap listing style hero section
// Based on osu-web beatmapsets-search component

interface FilterItem {
  name: string;
  gold?: boolean;
  tooltip?: string;
  link?: string;
}

// Data structure for filter items - easy to modify
const filterData: Record<string, FilterItem[]> = {
  working: [
    { name: "Lunabill (F25)", gold: true, tooltip: "Y Combinator F25 startup - automating medical insurance calls" },
    { name: "Foxconn", tooltip: "MLE Intern - latency optimization for multilingual voice agents" },
    { name: "Formosa Dental", tooltip: "A billing and inventory management platform for formosa dental clinic" },
    { name: "Hire Me!", gold: true, link: "/work" },
  ],
  location: [
    { name: "San Francisco", gold: true  },
    { name: "San Diego"},
    { name: "Taiwan" },
    { name: "Japan" },
  ],
  stack: [
    { name: "C++", gold: true, tooltip: "competitive programming, low level learning" },
    { name: "Rust", gold: true},
    { name: "Python", tooltip: "ML/AI, scripting" },
    { name: "TypeScript", gold: true, tooltip: "full-stack stuff" },
    { name: "Astro", gold: true, tooltip: "This portfolio!" },
    { name: "Svelte", gold: true, tooltip: "Runes" },
    { name: "React" },
    { name: "PyTorch", tooltip: "ML / Deep learning" },
    { name: "NeonDB", tooltip: "sql" },
  ],
  interests: [
    { name: "Competitive Programming", gold: true, tooltip: "AtCoder, Codeforces, ICPC" },
    { name: "osu!", tooltip: "<3 osu!", link: "https://osu.ppy.sh/users/13370667" },
    { name: "Piano", tooltip: "chopin", gold: true, link: "/piano" },
    { name: "Calisthenics", tooltip: "in progress" },
    { name: "Running", gold: true, tooltip: "in progress" },
    { name: "Travel", tooltip: "japan" },
  ],
};
---

<div class="hero-search">
  <!-- Background cover with transparency -->
  <div class="hero-search__cover">
    <img src="/sky.webp" alt="" class="hero-search__cover-image" />
  </div>

  <!-- Content -->
  <div class="hero-search__content">
    <!-- Header row -->
    <div class="hero-search__header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-search__logo-icon">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"/>
        <path d="M12 7.5V9"/>
        <path d="M7.5 12H9"/>
        <path d="M16.5 12H15"/>
        <path d="M12 16.5V15"/>
        <path d="m8 8 1.88 1.88"/>
        <path d="M14.12 9.88 16 8"/>
        <path d="m8 16 1.88-1.88"/>
        <path d="M14.12 14.12 16 16"/>
      </svg>
      <h1 class="hero-search__title">seraph's portfolio</h1>
    </div>

    <!-- Filter grid -->
    <div class="hero-search__filter-grid">
      <!-- Row 1: Working -->
      <div class="hero-search__filter-row hero-search__filter-row--grid">
        <span class="hero-search__filter-header">Working</span>
        <div class="hero-search__filter-items">
          {filterData.working.map((item) => (
            item.link ? (
              <a href={item.link} class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`} data-tooltip={item.tooltip}>
                {item.name}
                {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
              </a>
            ) : (
              <span class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`} data-tooltip={item.tooltip}>
                {item.name}
                {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
              </span>
            )
          ))}
        </div>
      </div>

      <!-- Row 2: Location -->
      <div class="hero-search__filter-row hero-search__filter-row--grid">
        <span class="hero-search__filter-header">Location</span>
        <div class="hero-search__filter-items">
          {filterData.location.map((item) => (
            <span class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`} data-tooltip={item.tooltip}>
              {item.name}
              {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
            </span>
          ))}
        </div>
      </div>

      <!-- Row 3: Stack -->
      <div class="hero-search__filter-row hero-search__filter-row--grid">
        <span class="hero-search__filter-header">Stack</span>
        <div class="hero-search__filter-items">
          {filterData.stack.map((item) => (
            <span class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`} data-tooltip={item.tooltip}>
              {item.name}
              {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
            </span>
          ))}
        </div>
      </div>

      <!-- Row 4: Interests -->
      <div class="hero-search__filter-row hero-search__filter-row--grid">
        <span class="hero-search__filter-header">Interests</span>
        <div class="hero-search__filter-items">
          {filterData.interests.map((item) => (
            item.link ? (
              <a
                href={item.link}
                {...(item.link.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`}
                data-tooltip={item.tooltip}
              >
                {item.name}
                {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
              </a>
            ) : (
              <span class={`hero-search__filter-item ${item.gold ? 'hero-search__filter-item--featured-artists' : ''}`} data-tooltip={item.tooltip}>
                {item.name}
                {item.tooltip && <span class="hero-search__tooltip">{item.tooltip}</span>}
              </span>
            )
          ))}
        </div>
      </div>

      <!-- Footer row -->
      <div class="hero-search__footer">
        <a href="/about" class="hero-search__expand-link">
          More About Me
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-search__expand-icon">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>
        <div class="hero-search__legend">
          <span class="hero-search__legend-box"></span>
          <span class="hero-search__legend-text">Active</span>
        </div>
      </div>
    </div>
  </div>
</div>
