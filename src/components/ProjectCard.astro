---
import Badge from '@/components/Badge.astro'
import Link from '@/components/Link.astro'
import { Separator } from '@/components/ui/separator'

import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props

const formatMonthYear = (date: Date) => {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
}

const extractDomain = (url: string) => {
  try {
    const domain = new URL(url).hostname.replace('www.', '')
    return domain
  } catch {
    return url
  }
}

const imgSrc = project.data.image ? (project.data.image as any).src : null
---

<div
  class="hover:border-border hover:bg-bg-fuchsia-50 border p-4 transition-all duration-300 ease-in-out hover:shadow-sm"
>
  {
    project.data.link ? (
      <Link
        href={project.data.link}
        class="flex flex-col gap-4 sm:flex-row"
        external
      >
        {project.data.image && (
          <button
            class="project-img-btn w-full sm:max-w-3xs sm:shrink-0 cursor-zoom-in overflow-hidden rounded-sm aspect-[1200/630] block"
            data-img-src={imgSrc}
            data-img-alt={project.data.name}
          >
            <Image
              src={project.data.image}
              alt={project.data.name}
              width={1200}
              height={1200}
              class="w-full h-full object-cover object-center"
            />
          </button>
        )}
        <div class="grow">
          <h3 class="mb-1 text-lg font-medium">{project.data.name}</h3>
          <p class="text-muted-foreground mb-2 text-sm">
            {project.data.description}
          </p>
          {project.data.startDate && (
            <div class="text-muted-foreground/70 mb-2 flex flex-wrap items-center gap-x-2 text-xs">
              <span class="flex items-center gap-x-1.5">
                <Icon name="lucide:calendar" class="size-3" />
                <span>
                  {formatMonthYear(project.data.startDate)}
                  {project.data.endDate
                    ? ` → ${formatMonthYear(project.data.endDate)}`
                    : ' → Present'}
                </span>
              </span>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-x-1">
                <Icon name="lucide:external-link" class="size-3" />
                <span>{extractDomain(project.data.link)}</span>
              </span>
            </div>
          )}
          {project.data.tags && (
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag: string) => (
                <Badge text={tag} />
              ))}
            </div>
          )}
        </div>
      </Link>
    ) : (
      <div class="flex flex-col gap-4 sm:flex-row">
        {project.data.image && (
          <button
            class="project-img-btn w-full sm:max-w-3xs sm:shrink-0 cursor-zoom-in overflow-hidden rounded-sm aspect-[1200/630] block"
            data-img-src={imgSrc}
            data-img-alt={project.data.name}
          >
            <Image
              src={project.data.image}
              alt={project.data.name}
              width={1200}
              height={1200}
              class="w-full h-full object-cover object-center"
            />
          </button>
        )}
        <div class="grow">
          <h3 class="mb-1 text-lg font-medium">{project.data.name}</h3>
          <p class="text-muted-foreground mb-2 text-sm">
            {project.data.description}
          </p>
          {project.data.startDate && (
            <div class="text-muted-foreground/70 mb-2 flex flex-wrap items-center gap-x-2 text-xs">
              <span class="flex items-center gap-x-1.5">
                <Icon name="lucide:calendar" class="size-3" />
                <span>
                  {formatMonthYear(project.data.startDate)}
                  {project.data.endDate
                    ? ` → ${formatMonthYear(project.data.endDate)}`
                    : ' → Present'}
                </span>
              </span>
            </div>
          )}
          {project.data.tags && (
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag: string) => (
                <Badge text={tag} />
              ))}
            </div>
          )}
        </div>
      </div>
    )
  }
</div>

<script>
  if (!document.getElementById('img-click-preview')) {
    const overlay = document.createElement('div')
    overlay.id = 'img-click-preview'
    overlay.className = 'fixed inset-0 z-50 flex items-center justify-center'
    overlay.style.display = 'none'
    overlay.style.background = 'rgba(0,0,0,0.6)'
    overlay.innerHTML = '<img style="max-height:85vh;max-width:85vw;object-fit:contain;border-radius:8px;box-shadow:0 25px 60px rgba(0,0,0,0.5)" />'
    overlay.addEventListener('click', () => { overlay.style.display = 'none' })
    document.body.appendChild(overlay)
  }

  document.querySelectorAll('.project-img-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      const overlay = document.getElementById('img-click-preview')!
      const overlayImg = overlay.querySelector('img')!
      const srcImg = (btn as HTMLElement).querySelector('img')
      overlayImg.src = srcImg?.src || (btn as HTMLElement).dataset.imgSrc || ''
      overlay.style.display = 'flex'
    })
  })
</script>
