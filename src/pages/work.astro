---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects, groupProjectsByYear } from '@/lib/data-utils'

const allProjects = await getAllProjects()
// Filter to only work experiences (exclude personal projects)
const workProjects = allProjects.filter(
  (p) =>
    !p.id.includes('tsukiyomi') &&
    !p.id.includes('cp-dashboard') &&
    !p.id.includes('cp-solutions') &&
    !p.id.includes('interview-platform') &&
    !p.id.includes('icpc-huawei-scheduler') &&
    !p.id.includes('clipfarm') &&
    !p.id.includes('doomschool') &&
    !p.id.includes('mindsolve') &&
    !p.id.includes('seraph-agent') &&
    !p.id.includes('old-blog') &&
    !p.id.includes('nvim-configs') &&
    !p.id.includes('tmux-config'),
)
const projectsByYear = groupProjectsByYear(workProjects)
const years = Object.keys(projectsByYear).sort(
  (a, b) => parseInt(b) - parseInt(a),
)
---

<Layout>
  <PageHead
    slot="head"
    title="Work"
    description="Work experience and professional projects"
  />
  <div class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)]">
    <Breadcrumbs items={[{ label: 'Work', icon: 'lucide:briefcase' }]} />
  </div>

  <section
    class="mx-auto flex max-w-[calc(var(--container-3xl)-2rem)] flex-col gap-4"
  >
    <div class="flex flex-col gap-y-8">
      {
        years.map((year) => (
          <section class="flex flex-col gap-y-4">
            <h2 class="font-display text-muted-foreground flex items-center gap-3 text-sm font-semibold">
              <span>{year}</span>
              <span class="bg-border h-px flex-1" />
            </h2>
            <ul class="flex flex-col gap-4">
              {projectsByYear[year].map((project) => (
                <li>
                  <ProjectCard project={project} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
