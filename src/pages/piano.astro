  },
]

const BAR_LEN = 20

function bar(pct: number): string {
  const filled = Math.round((pct / 100) * BAR_LEN)
  const empty = BAR_LEN - filled
  return '▓'.repeat(filled) + '░'.repeat(empty)
}

function barColor(pct: number): string {
  if (pct >= 70) return 'hsl(140, 60%, 50%)'
  if (pct >= 40) return 'hsl(200, 80%, 60%)'
  return 'hsl(45, 100%, 60%)'
}
---

<Layout>
  <PageHead slot="head" title="Piano" description="Pieces I'm currently learning" />

  <div class="mx-auto w-full max-w-3xl">
    <Breadcrumbs items={[{ label: 'Piano', icon: 'lucide:piano' }]} />
  </div>

  <section class="mx-auto w-full max-w-3xl px-4 pb-12">
    <div class="flex flex-col divide-y divide-border">
      {[...pieces].sort((a, b) => b.pct - a.pct).map((piece) => (
        <div class="flex items-center gap-4 py-3">

          <Icon name="lucide:music" class="size-3.5 shrink-0 text-muted-foreground/50" />

          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2 min-w-0">
              {piece.link ? (
                <a
                  href={piece.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="truncate text-sm font-medium hover:underline"
                >
                  {piece.title}
                </a>
              ) : (
                <span class="truncate text-sm font-medium">{piece.title}</span>
              )}
              <span class="text-muted-foreground shrink-0 text-xs">{piece.composer}</span>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            <span
              class="font-mono text-xs tracking-tighter"
              style={`color: ${barColor(piece.pct)}`}
            >
              {bar(piece.pct)}
            </span>
            <span class="w-8 text-right font-mono text-xs text-muted-foreground">
              {piece.pct}%
            </span>
          </div>

        </div>
      ))}
    </div>
  </section>
</Layout>
