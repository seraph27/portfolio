---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

interface Item {
  name: string
  icon: string
  link?: string
  /** A few words, only where the name alone says nothing */
  note?: string
}

interface Section {
  heading: string
  items: Item[]
}

// Only what is in use now. Add a note only when the name needs one.
const sections: Section[] = [
  {
    heading: 'Languages',
    items: [
      { name: 'C++', link: 'https://isocpp.org/', icon: 'simple-icons:cplusplus' },
      { name: 'TypeScript', link: 'https://www.typescriptlang.org/', icon: 'simple-icons:typescript' },
      { name: 'Python', link: 'https://www.python.org/', icon: 'simple-icons:python' },
      { name: 'Bash', link: 'https://www.gnu.org/software/bash/', icon: 'simple-icons:gnubash' },
    ],
  },
  {
    heading: 'Web',
    items: [
      { name: 'Next.js', link: 'https://nextjs.org/', icon: 'simple-icons:nextdotjs' },
      { name: 'React', link: 'https://react.dev/', icon: 'simple-icons:react' },
      { name: 'Svelte 5', link: 'https://svelte.dev/', icon: 'simple-icons:svelte' },
      { name: 'Astro', link: 'https://astro.build/', icon: 'simple-icons:astro' },
      { name: 'Tailwind CSS', link: 'https://tailwindcss.com/', icon: 'simple-icons:tailwindcss' },
      { name: 'shadcn/ui', link: 'https://ui.shadcn.com/', icon: 'simple-icons:shadcnui' },
      { name: 'Drizzle ORM', link: 'https://orm.drizzle.team/', icon: 'simple-icons:drizzle' },
      { name: 'Neon', link: 'https://neon.tech/', icon: 'simple-icons:postgresql', note: 'Postgres' },
      { name: 'Vercel', link: 'https://vercel.com/', icon: 'simple-icons:vercel' },
    ],
  },
  {
    heading: 'At LunaBill',
    items: [
      { name: 'Telnyx', link: 'https://telnyx.com/', icon: 'lucide:phone-call', note: 'telephony' },
      { name: 'Vogent', link: 'https://vogent.ai/', icon: 'lucide:phone', note: 'voice agents' },
      { name: 'Respan', link: 'https://respan.ai/', icon: 'lucide:brain', note: 'LLM observability' },
      { name: 'Parsebot', link: 'https://parsebot.io/', icon: 'lucide:globe', note: 'portal automation' },
      { name: 'Stedi', link: 'https://stedi.com/', icon: 'lucide:building-2', note: 'payer data' },
      { name: 'Availity', link: 'https://availity.com/', icon: 'lucide:shield-check', note: 'eligibility and claims' },
    ],
  },
  {
    heading: 'Tools',
    items: [
      { name: 'Neovim', link: 'https://neovim.io/', icon: 'simple-icons:neovim' },
      { name: 'tmux', link: 'https://github.com/tmux/tmux', icon: 'simple-icons:tmux' },
      { name: 'Zsh', link: 'https://www.zsh.org/', icon: 'lucide:terminal' },
      { name: 'Claude Code', link: 'https://claude.ai/code', icon: 'simple-icons:claude' },
      { name: 'Codex', link: 'https://openai.com/codex', icon: 'simple-icons:openai' },
      { name: 'Gemini', link: 'https://gemini.google.com/', icon: 'simple-icons:googlegemini' },
      { name: 'Greptile', link: 'https://greptile.com/', icon: 'lucide:search-code', note: 'code review' },
      { name: 'GitHub', link: 'https://github.com/', icon: 'simple-icons:github' },
      { name: 'Obsidian', link: 'https://obsidian.md/', icon: 'simple-icons:obsidian' },
      { name: 'Zen Browser', link: 'https://zen-browser.app/', icon: 'simple-icons:zenbrowser' },
      { name: 'Tsukiyomi', link: 'https://github.com/seraph27/tsukiyomi', icon: 'lucide:layout-dashboard', note: 'my menu bar app' },
      { name: 'ani-cli', link: 'https://github.com/pystardust/ani-cli', icon: 'lucide:tv-2' },
      { name: 'macOS', link: 'https://www.apple.com/macos/', icon: 'lucide:command' },
    ],
  },
  {
    heading: 'Hardware',
    items: [
      { name: 'MacBook Pro M5 Pro', link: 'https://www.apple.com/macbook-pro/', icon: 'simple-icons:apple' },
      { name: 'Custom Mini ITX', icon: 'lucide:cpu', note: 'Ryzen 3600X, RTX 2060 Super' },
      { name: 'Tofu 60 Redux + Wooting PCB', link: 'https://wooting.io/wooting-60he', icon: 'lucide:keyboard', note: 'Raptors HE' },
      { name: 'Wacom CTL-485', link: 'https://www.wacom.com/', icon: 'lucide:pen-line', note: 'for osu!' },
      { name: 'Sony WH-1000XM4', link: 'https://www.sony.com/', icon: 'lucide:headphones' },
    ],
  },
]
---

<Layout>
  <PageHead slot="head" title="Stack" description="Tools, stack, and setup" />

  <div class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)]">
    <Breadcrumbs items={[{ label: 'Stack', icon: 'lucide:wrench' }]} />
  </div>

  <section
    class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)] pb-12"
  >
    <dl class="divide-border divide-y">
      {
        sections.map((section) => (
          <div class="grid gap-x-6 gap-y-3 py-5 first:pt-2 sm:grid-cols-[7.5rem_1fr]">
            <dt class="font-display text-muted-foreground text-sm font-semibold sm:pt-1.5">
              {section.heading}
            </dt>
            <dd class="flex flex-wrap gap-2">
              {section.items.map((item) => {
                const Tag = item.link ? 'a' : 'span'
                const props = item.link
                  ? {
                      href: item.link,
                      target: '_blank',
                      rel: 'noopener noreferrer',
                    }
                  : {}
                return (
                  <Tag
                    {...props}
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-sm',
                      item.link &&
                        'hover:border-foreground/25 hover:bg-muted/50 transition-colors motion-reduce:transition-none',
                    ]}
                  >
                    <Icon
                      name={item.icon}
                      class="text-foreground/55 size-3.5 shrink-0"
                    />
                    <span class="font-medium">{item.name}</span>
                    {item.note && (
                      <span class="text-muted-foreground text-xs">
                        {item.note}
                      </span>
                    )}
                  </Tag>
                )
              })}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
